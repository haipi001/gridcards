# Copy to .env.local for local development, or set these in your host's build
# environment. Every one of them is read at BUILD time (static export), never at
# runtime — changing a value requires a rebuild.

# Absolute origin, no trailing slash. Baked into canonical URLs, Open Graph tags
# and sitemap.xml. Required: without it the site advertises
# https://gridcards.example.com to crawlers.
NEXT_PUBLIC_SITE_URL=https://gridcards.example.com

# Leave unset to ship the bundled mock dataset (public/mock/*.json).
# Set it to switch the entire marketplace to a real backend — the six resources
# listed in docs/MARKET.md must exist at that base URL.
# NEXT_PUBLIC_MARKET_API=https://api.example.com/v1

# Simulated read latency in ms while running on mock data, so loading states are
# actually visible. Forced to 0 when NEXT_PUBLIC_MARKET_API points at a real API.
# NEXT_PUBLIC_MOCK_LATENCY=260

# Allow the ?trade=1 (unfreeze trade buttons) and ?fail=1 (force a read error)
# debug switches in a production build. They are always on in `next dev`.
# Demo / review builds only — never enable on a site that claims to be live.
# NEXT_PUBLIC_DEV_SWITCHES=1
