# Cloudflare Pages / Netlify-style header rules.
#
# `output: "export"` means Next cannot set response headers, so security and
# caching policy lives here (Cloudflare Pages), in vercel.json and in
# netlify.toml. Keep the three in sync — docs/DEPLOY.md lists what each covers.

# ---- security, every path -------------------------------------------------
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

# ---- HTML: short cache so a deploy is visible immediately ----------------
# (matches every path; the rules below add the long-lived asset cache)
/*
  Cache-Control: public, max-age=0, must-revalidate

# ---- immutable build output ---------------------------------------------
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ---- card imagery: filename-addressed, never changes --------------------
/img/*
  Cache-Control: public, max-age=31536000, immutable

# ---- mock dataset: regenerated by npm run mock:gen ----------------------
/mock/*
  Cache-Control: public, max-age=300, must-revalidate
